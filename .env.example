# CHAT_MODEL 必须是上游实际支持的模型 ID；不提供本地别名。
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Ch04 评估裁判独立于客服模型，使用同一 CHAT 上游与密钥。
JUDGE_MODEL=zai-org/GLM-5.2
CHAT_API_KEY=
CHAT_MEMORY_TOKEN_BUDGET=2000
# 使用固定 tokenizer 兼容任意上游模型名；按实际模型调整。
CHAT_TOKEN_ENCODING=cl100k_base
CHAT_TIMEOUT_SECONDS=60
# json_schema 需上游支持原生 Structured Outputs；不使用工具调用。

# Ch03 dense 检索；密钥只填入本地 .env。
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
SILICONFLOW_API_KEY=
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5
KB_SOURCE_DIR=data/kb
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# Docker MySQL: choose local-only passwords and use the same MYSQL_PASSWORD in both URLs.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_PASSWORD=replace-with-a-local-app-password
MYSQL_PORT=3306
DATABASE_URL=mysql+asyncmy://aicare:replace-with-a-local-app-password@127.0.0.1:3306/aicare?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://aicare:replace-with-a-local-app-password@127.0.0.1:3306/aicare_test?charset=utf8mb4
TOOL_TIMEOUT_SECONDS=10
TOOL_READ_RETRIES=1

# Ch04: evidence gate applies to reranker relevance, not BM25/RRF scores
RERANK_MIN_SCORE=0.5

# Ch05 LangGraph 持久会话与步数上限
GRAPH_CHECKPOINT_PATH=data/checkpoints/conversations.sqlite
MAX_AGENT_STEPS=6

# Ch06: blank INTENT_MODEL uses CHAT_MODEL. Cost fields are seeds only.
INTENT_MODEL=
INTENT_SMALL_MODEL=
INTENT_MODE=accuracy
INTENT_CONF_THRESHOLD=0.8
REFERENCE_HISTORY_TURNS=4

# Ch07: window auto-detection; a provider's actual lower limit can override it.
MODEL_CONTEXT_WINDOW=0
CONTEXT_BUDGET_TURNS=20
MAX_USER_INPUT_TOKENS=2000
MAX_OUTPUT_TOKENS=10000
SYSTEM_PROMPT_TOKENS=700
EVIDENCE_TOKENS_PER_CHUNK=160
LAYER1_RATIO=0.7
LAYER2_REPLY_KEEP_CHARS=60
LAYER2_TOOL_KEEP_TOKENS=200
TOOL_RESULT_MAX_TOKENS=3000
AGENT_STEP_AI_TOKENS=500
SUMMARY_INJECT_SEGMENTS=3
SUMMARY_TOKENS_PER_SEGMENT=250
BUDGET_SAFETY_MARGIN=1000
ZH_CHARS_PER_TOKEN=1.2
CONTEXT_WINDOW_MAX_TOKENS=0
SUMMARY_MODEL=
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
# Ch08 · local MCP servers / execution governance
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
TOOL_DEFAULT_TIMEOUT=5
MCP_TOOL_TIMEOUT=10
# Catalog cache only; 0 disables caching. Failures retry after a short cooldown.
MCP_DISCOVERY_TTL_SECONDS=60
MCP_DISCOVERY_FAILURE_TTL_SECONDS=5
TOOL_MAX_RETRIES=2
DEMO_TICKET_DELAY_SECONDS=0

# Ch09 · optional local tracing (do not use a cloud endpoint by default)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Calibration report determines the default in app/config.py. Optional explicit override:
# EVIDENCE_CONFIDENCE_THRESHOLD=

